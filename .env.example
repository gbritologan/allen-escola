# ---------------------------------------------------------------------------
# Allen Escola — variáveis de ambiente
# Copie para .env.local e preencha. Nada aqui vai para o Git.
# ---------------------------------------------------------------------------

# Supabase --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Só no servidor. Ignora RLS — nunca expor ao cliente, nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# Vídeo (D-17) ----------------------------------------------------------------
# Provedor ativo: "bunny" | "mux". Trocar aqui troca a implementação inteira.
VIDEO_PROVIDER="bunny"

# Bunny Stream
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_CDN_HOSTNAME=""
BUNNY_STREAM_TOKEN_KEY=""

# Mux (só se VIDEO_PROVIDER=mux)
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_KEY_PRIVATE=""

# App -------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
